# --- Apple News ---
# 核心 API 与边缘节点
domain-suffix,news-client.apple.com
domain-suffix,news-edge.apple.com
domain-suffix,news-events.apple.com
domain-suffix,news-assets.apple.com
domain-suffix,news-client-search.apple.com
domain-suffix,news.iadsdk.apple.com

# 专属域名后缀
domain-suffix,apple.news
domain-suffix,applenewsformat.com

# 专属 User-Agent
USER-AGENT,AppleNews*
USER-AGENT,com.apple.news*


# --- Apple Podcasts ---
# 专属域名与 API
domain-suffix,podcasts.apple.com
domain-suffix,amp-api.podcasts.apple.com
domain-suffix,pcast.apple.com

# 播放进度同步 (注意: 该域名同时也负责 Apple Books 图书的进度同步)
domain-suffix,bookkeeper.itunes.apple.com

# 专属 User-Agent
USER-AGENT,podcasts*
USER-AGENT,*Podcasts*
USER-AGENT,com.apple.podcasts*